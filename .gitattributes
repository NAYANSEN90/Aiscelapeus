# Normalize every text file to LF in the repository and on checkout,
# regardless of each machine's core.autocrlf setting.
* text=auto eol=lf

# Windows shells genuinely require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries - never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.mp3 binary
*.wav binary
*.onnx binary
