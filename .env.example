# ---------------------------------------------------------------------------
# Copy to .env.local (agent) and web/.env.local (web app), then fill in.
# Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- LiveKit (both agent and web) ------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The web app needs the URL client-side as well.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
# Required by the production web runtime. Each must be at least 16 characters and
# they must differ, so a responder link cannot self-assert the clinician role and
# read the timeline. Startup readiness and token minting reject an invalid pair.
RESPONDER_ACCESS_CODE=
CLINICIAN_ACCESS_CODE=

# --- Moss -------------------------------------------------------------------
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_PROTOCOLS_INDEX=aiscelapeus-protocols
MOSS_SESSION_INDEX_PREFIX=aiscelapeus-session
# Retrieval budget the system holds itself to. Breaches are traced and logged.
MOSS_LATENCY_BUDGET_MS=10
MOSS_PROTOCOL_TOP_K=3
MOSS_STATE_TOP_K=5

# --- Speech: Deepgram covers BOTH STT and TTS on this one key ---------------
# ElevenLabs was dropped: Aura-2 rides the key below, and the published TTFB
# gap was 40-50 ms against a budget the LLM overruns by ~2 s. One less vendor.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-medical
DEEPGRAM_LANGUAGE=en-US
# Aura-2 picks the speaker through the model id itself (aura-2-<voice>-en),
# so there is no separate voice id to set.
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# --- Language model: Gemini -------------------------------------------------
# OpenAI was dropped (no credits available). Note that `openai` still installs
# as a transitive dependency of livekit-agents, so an import succeeding proves
# nothing about what this build is wired to.
GEMINI_API_KEY=
# The only supported value; a typo here is rejected at startup rather than
# silently falling back to a default.
LLM_PROVIDER=gemini
# gemini-2.5-flash is RETIRED and returns 404 for new users - do not use it.
LLM_MODEL=gemini-3.6-flash
# Tried when the primary fails; one candidate model returned 503, which is why
# a chain exists. Must differ from LLM_MODEL, or startup fails: retrying the
# model that just failed is not a fallback.
LLM_FALLBACK_MODEL=gemini-3.7-flash
LLM_TEMPERATURE=0.2

# --- Triage -----------------------------------------------------------------
# Criticality at or above this bridges a clinician onto the call.
ESCALATION_THRESHOLD=4
# How long a clinician request may go unanswered before it is recorded as
# FAILED_NO_RESPONSE rather than left pending forever.
DISPATCH_TIMEOUT_S=30
# DISTRESS_THRESHOLD is deliberately absent. `config.py` reads no such setting,
# and the `distress_score` it was meant to gate was removed from the wire
# payload as a field no code path ever wrote (see tests/unit/test_triage.py
# ::test_payload_carries_no_unwritten_fields). Listing it here would advertise
# a knob that does nothing - the same defect shape as requiring a key for a
# vendor that was dropped. It returns when something actually consumes it.

# --- Observability ----------------------------------------------------------
APP_ENV=development
OTEL_SERVICE_NAME=aiscelapeus-agent
# Any OTLP/HTTP collector: Arize Phoenix, LangSmith, Grafana Tempo, Jaeger.
# Leave blank to log traces to the console only.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORT=true
# PHI in spans. Fails CLOSED: this has effect ONLY when APP_ENV=development,
# and both conditions are required, so leaving it false (or unset) is the safe
# state. Never enable it against a real incident.
OTEL_ALLOW_PII=false
